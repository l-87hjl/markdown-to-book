#!/bin/sh
# Optional local hook: installation is explicit and local; this is not access control.
set -eu
while read -r local_ref local_oid remote_ref remote_oid; do
  [ "$local_oid" != 0000000000000000000000000000000000000000 ] || continue
  case "$remote_ref" in
    refs/heads/main|refs/heads/master)
      echo 'Direct maintained/default-branch pushes are blocked; use reviewed PRs.' >&2
      exit 1 ;;
    refs/heads/upstream-tracking)
      [ "$(git rev-parse "$local_oid")" = "$(git rev-parse refs/remotes/upstream/main)" ] || {
        echo 'upstream-tracking differs from the fetched original upstream.' >&2; exit 1;
      } ;;
    *)
      if [ "$remote_oid" = 0000000000000000000000000000000000000000 ]; then
        base=refs/remotes/origin/main
      else
        base=$remote_oid
      fi
      python3 scripts/publication_preflight.py --range "$base..$local_oid" ;;
  esac
done
